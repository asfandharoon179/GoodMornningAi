# Copy to .env and replace every placeholder with your own values.
# Never commit .env or put real credentials in this template.
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
ALLOWED_ORIGIN=http://localhost:5000

MONGODB_URI=mongodb://127.0.0.1:27017/goodmorningai
JWT_SECRET=replace-with-at-least-32-random-bytes
REFRESH_SECRET=replace-with-a-different-32-byte-random-secret
DAILY_LIMIT=10

GEMINI_API_KEY=replace-me
UNSPLASH_ACCESS_KEY=

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:admin@example.com

# Optional password-reset email delivery. Required to use forgot-password in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
